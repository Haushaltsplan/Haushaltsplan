# Kopieren nach .env.local und Werte eintragen. Dev-Server danach neu starten.
#
# Wichtig für die ONLINE-App (Vercel o.ä.): .env.local wird NICHT deployt. Dort unter
# Project Settings → Environment Variables dieselben Variablen setzen (z. B. GEMINI_API_KEY)
# und ein neues Deployment auslösen. Lokal: npm run check:ki

# Öffentliche HTTPS-URL nach Deploy (z. B. Vercel) — erscheint oben in der App, damit du sie auf dem Handy findest
# NEXT_PUBLIC_APP_URL=https://dein-projekt.vercel.app

# KI-Coach — ein Anbieter reicht. Bei mehreren Schlüsseln: FINANCE_COACH_PROVIDER=auto|gemini|openai (Standard auto, Gemini bevorzugt).
# Kassenbon-Fotos im Chat: Gemini Vision (Standard) oder OpenAI mit Vision-Modell (z. B. gpt-4o-mini).
# Seite /natur (Tiere, Pflanzen, Pilze per Foto): entfernt.

# Gemini / Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Kostenloses Tageskontingent (Projekt OHNE Billing) — Modeberater, Portfolio-Berater, Flash-Coaches:
# GEMINI_API_KEY_FREE=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Kassenzettel → Lager (Server-Buchung; Supabase → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional:
# FINANCE_COACH_PROVIDER=auto
# GOOGLE_GENERATIVE_AI_API_KEY=   # Alias für GEMINI_API_KEY
# FINANCE_COACH_GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
# Free-Tier-Fallbacks (nur Flash — kein Pro, kein 3.1-flash-lite):
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite
# Earnings Call — Free-Tier-Flash; bei Quota/429 automatisch nächstes Modell:
# EARNINGS_CALL_GEMINI_MODEL=gemini-3.5-flash
# EARNINGS_CALL_GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash
# Nachkauf-Radar Stufe A (Scan) — Free-Tier-Flash:
# NACHKAUF_SCAN_GEMINI_MODEL=gemini-3.5-flash
# Nachkauf-Radar Stufe B/C (Deep Research + Kaufempfehlung) — kostenpflichtig, nur 3.1 Pro:
# NACHKAUF_DEEP_RESEARCH_GEMINI_MODEL=gemini-3.1-pro-preview
# NACHKAUF_DEEP_RESEARCH_GEMINI_MODEL_FALLBACKS=gemini-3.1-pro-preview-customtools,gemini-3.1-pro-exp
# AI_API_KEY=
# FINANCE_COACH_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Startseite — Google-News-Blöcke Profi Radsport / Profi Wintersport (optional, eine Zeile je Suchanfrage)
# Radsport-Standard: Team-/Renn-Liste in lib/sport-rennrad-keywords.ts (Batches)
# Wintersport-Standard: Events, Orte, Athleten, Fachbegriffe in lib/sport-winter-keywords.ts (Batches)
# Radsport/Wintersport selbst: eine Zeile ersetzt die jeweilige Liste. Operatoren: OR, "…", site:…, when:…
# Ohne when:… wird when:14d angehängt. Beispiel: HAUSHALT_SPORT_RENNRAD_QUERY=site:example.com OR "Tour de France"
# HAUSHALT_SPORT_RENNRAD_QUERY=
# HAUSHALT_SPORT_WINTER_QUERY=

# Investments / Movers — reine Kursdaten (Yahoo/Polygon), keine KI-Einordnung.
# Client-Refresh (Standard 300 s):
# NEXT_PUBLIC_INVESTMENTS_REFRESH_MS=300000

# Parqet-Portfolio (öffentliche URL, optional)
NEXT_PUBLIC_PARQET_PORTFOLIO_URL=https://app.parqet.com/p/6441703508967dae17ea661e

# Portfolioanalyse — angekündigte Dividenden: DivvyDiary (ISIN, ohne Key) + Yahoo; optional Finnhub (US, oft 403 im Free-Tier)
# FINNHUB_API_KEY=

# Portfolioanalyse — Earnings Call: SEC EDGAR (US, kostenlos) + optional Finnhub Transcripts (Professional)
# SEC verlangt User-Agent mit Kontakt — Standard: APP_ALLOWED_EMAILS
# SEC_EDGAR_USER_AGENT=Omnia Haushalt deine@email.de

# Strava — https://www.strava.com/settings/api
# Authorization Callback Domain (nur Hostname!): haushaltsplan-blue.vercel.app  — NICHT https://… und NICHT /api/…
# Redirect URI der App: https://DEINE-URL/api/strava/callback
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# NEXT_PUBLIC_APP_URL=https://dein-projekt.vercel.app
# Optional feste Redirect-URI (wenn Request-Origin abweicht):
# STRAVA_REDIRECT_URI=https://dein-projekt.vercel.app/api/strava/callback

# WHOOP Cloud OAuth (SpO₂ / Recovery) — https://developer.whoop.com/
# Redirect-URI im WHOOP Developer Dashboard: https://DEINE-URL/api/fitnessdaten/whoop/callback
# Privacy Policy URL im Dashboard: https://DEINE-URL/datenschutz
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=

# Im Supabase-Projekt: Project Settings → API → Project URL + anon (public) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SICHERHEIT / „nur für mich“ (siehe SECURITY.md):
# Nur diese E-Mail(s) dürfen die App nutzen. Mehrere mit Komma trennen.
# APP_ALLOWED_EMAILS wird serverseitig in der Middleware geprüft (schützt alle /api-Routen).
# NEXT_PUBLIC_ALLOWED_EMAILS ist dieselbe Liste für die Login-Oberfläche (gleiche Adresse(n) eintragen).
APP_ALLOWED_EMAILS=
NEXT_PUBLIC_ALLOWED_EMAILS=
#
# Investments „Meine Unternehmen“: bearbeitbare Liste über Supabase-Tabellen investment_portfolio_* .
# Einmalig mit DATABASE_URL in .env.local: npm run db:investment-portfolio
# (SQL: supabase/migrations/20260502143000_investment_portfolio.sql).
# Ohne Tabellen nutzt die App automatisch data/investment-portfolio.json.
