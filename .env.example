# Kopieren nach .env.local und Werte eintragen. Dev-Server danach neu starten.
#
# Wichtig für die ONLINE-App (Vercel o.ä.): .env.local wird NICHT deployt. Dort unter
# Project Settings → Environment Variables dieselben Variablen setzen (z. B. GEMINI_API_KEY)
# und ein neues Deployment auslösen. Lokal: npm run check:ki

# Öffentliche HTTPS-URL nach Deploy (z. B. Vercel) — erscheint oben in der App, damit du sie auf dem Handy findest
# NEXT_PUBLIC_APP_URL=https://dein-projekt.vercel.app

# KI-Coach — ein Anbieter reicht. Bei mehreren Schlüsseln: FINANCE_COACH_PROVIDER=auto|gemini|openai (Standard auto, Gemini bevorzugt).
# Kassenbon-Fotos im Chat: Gemini Vision (Standard) oder OpenAI mit Vision-Modell (z. B. gpt-4o-mini).

# Gemini / Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Kassenzettel → Lager (Server-Buchung; Supabase → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional:
# FINANCE_COACH_PROVIDER=auto
# GOOGLE_GENERATIVE_AI_API_KEY=   # Alias für GEMINI_API_KEY
# FINANCE_COACH_GEMINI_MODEL=gemini-flash-latest
# AI_API_KEY=
# FINANCE_COACH_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Startseite — Google-News-Blöcke Profi Radsport / Profi Wintersport (optional, eine Zeile je Suchanfrage)
# Radsport-Standard: Team-/Renn-Liste in lib/sport-rennrad-keywords.ts (Batches)
# Wintersport-Standard: Events, Orte, Athleten, Fachbegriffe in lib/sport-winter-keywords.ts (Batches)
# Radsport/Wintersport selbst: eine Zeile ersetzt die jeweilige Liste. Operatoren: OR, "…", site:…, when:…
# Ohne when:… wird when:14d angehängt. Beispiel: HAUSHALT_SPORT_RENNRAD_QUERY=site:example.com OR "Tour de France"
# HAUSHALT_SPORT_RENNRAD_QUERY=
# HAUSHALT_SPORT_WINTER_QUERY=

# Parqet geteiltes Portfolio (Investments-Reiter — ohne diese Zeile kein Button)
NEXT_PUBLIC_PARQET_PORTFOLIO_URL=

# Supabase (Browser) — Pflicht für Speisekammer, Finanzen, Besitz, …
# Im Supabase-Projekt: Project Settings → API → Project URL + anon (public) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
