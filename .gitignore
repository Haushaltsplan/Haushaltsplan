# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Lokale Caches (z. B. frühere API-Caches)
.cache

# Investments-Portfolio ohne Supabase (lokal geschrieben von /api/investment-portfolio)
/data/investment-portfolio.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Secrets nicht committen — .env.example ist die Vorlage)
.env*
!.env.example

# vercel
.vercel

# Flutter WHOOP-App (eigenes Git-Repo, nicht ins Haushalt-Repo)
/whoop-app/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
